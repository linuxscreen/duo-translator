{
  "name": "duo-translator",
  "description": "manifest.json description",
  "private": true,
  "version": "2.2.5",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:safari": "wxt -b safari --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:safari": "wxt zip -b safari --mv3",
    "submit": "wxt submit",
    "compile": "tsc --noEmit",
    "i18n:check": "node scripts/checkI18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build": "cross-env WXT_OUTDIR=.output/e2e-build wxt build --mode development",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:no-real": "playwright test --config e2e/playwright.config.ts --grep-invert @real",
    "e2e:core": "playwright test --config e2e/playwright.config.ts --grep @core",
    "e2e:real": "playwright test --config e2e/playwright.config.ts --grep @real",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/opencc-js": "^1.0.3",
    "clsx": "^2.1.1",
    "css-selector-generator": "^3.6.8",
    "diff": "^9.0.0",
    "franc": "^6.2.0",
    "i18next": "^26.0.10",
    "lucide-react": "^1.14.0",
    "opencc-js": "^1.0.5",
    "react": "18.3.1",
    "react-colorful": "^5.7.0",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.7",
    "sentence-splitter": "^5.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.0.0",
    "@types/pouchdb": "^6.4.2",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "events": "^3.3.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "pouchdb": "^8.0.1",
    "tailwindcss": "4.3.0",
    "terser": "^5.36.0",
    "typescript": "^5.9.3",
    "vite-plugin-node-polyfills": "0.26.0",
    "vitest": "^4.1.5",
    "wxt": "^0.20.25"
  }
}