VITE_APP_NAME=Duo Translator
VITE_APP_NAME_KEBAB_CASE=duo-translator
VITE_APP_NAME_PASCAL_CASE=DuoTranslator
VITE_GOOGLE_API_KEY=your-google-api-key

# Google Drive sync (optional). Two OAuth client ids, no client_secret anywhere:
# neither credential path calls Google's token endpoint.
#   _CHROME = OAuth client type "Chrome extension"  -> identity.getAuthToken
#   _WEB    = OAuth client type "Web application"   -> implicit flow elsewhere
VITE_GOOGLE_CLIENT_ID_CHROME=
VITE_GOOGLE_CLIENT_ID_WEB=
# Optional: pins the unpacked extension id in dev (base64 public key of a .pem)
# so the "Chrome extension" OAuth client keeps matching it.
# CHROME_EXTENSION_KEY=

VITE_WEBSITE=https://duotranslator.com
VITE_GITHUB_URL=https://github.com/linuxscreen/duo-translator