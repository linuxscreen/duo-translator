// JSONC: `//` and `/* */` comments and trailing commas are allowed here
// annotate a selector with where it came from and
// what it covers, that context is what makes these rules maintainable.
// Everything else is plain JSON; no unquoted keys, no single quotes.
{
  "schemaVersion": 1,
  "name": "Duo Translator Built-in Rules",
  "updatedAt": "2026-08-11T00:00:00Z",
  "rules": [
    {
      "id": "github-general",
      "name": "Github General",
      "includeUrls": "github.com/*",
      "excludeSelectors": [
        "header",
        "footer"
      ]
    },
    {
      "id": "github-readme",
      "name": "Github Readme",
      "includeUrls": "github.com/*/*",
      "matchSelectors": [
        "meta[name=\"route-pattern\"][content$=\"/:user_id/:repository\"]" // home of repository
      ],
      "includeSelectors": [
        ".SidebarAbout-module__description__xTkIP", // About, In the top-right corner
        ".markdown-body" // readme body text
      ]
    },
    {
      "id": "github-issues",
      "name": "Github Issues",
      "includeUrls": "github.com/*/*/issues",
      "includeSelectors": [
        ".IssuePullRequestTitle-module__ListItemTitle_0__CBNvC .prc-Text-Text-9mHv3", // title
        ".tmp-p-4" // "If you have a bug or an idea, read the contributing guidelines before opening an issue." below the "All issues"
      ]
    },
    {
      "id": "github-pulls",
      "name": "Github Pulls",
      "includeUrls": "github.com/*/*/pulls",
      "includeSelectors": [
        ".js-issue-row .h4", // title
        ".js-notice p,h4" // "First time contributing" message
      ]
    },
    {
      "id": "github-actions",
      "name": "Github Actions",
      "includeUrls": "github.com/*/*/actions",
      "includeSelectors": [
        ".markdown-title", // action title
        ".container-md" // "Workflows aren’t being run on this forked repository"
      ]
    },
    {
      "id": "github-releases",
      "name": "Github Releases",
      "includeUrls": "github.com/*/*/releases*",
      "includeSelectors": [
        ".markdown-body" // body text
      ]
    },
    {
      "id": "github-blob-blame",
      "name": "Github Blob & Blame",
      "includeUrls": [
        "github.com/*/*/blob/*",
        "github.com/*/*/blame/*"
      ],
      "includeSelectors": [
        ".BlobContent-module__blobContentSectionMarkdown__mPLOK" // readme file preview
      ]
    },
    {
      "id": "github-profile",
      "name": "Github Profile",
      "includeUrls": "github.com/*",
      "matchSelectors": [
        "meta[name=\"route-pattern\"][content$=\"/:user_id(.:format)\"]" // user profile
      ],
      "includeSelectors": [
        ".pinned-item-desc", // pinned project description
        "[itemprop=\"description\"]", // description of repositories and stars
        ".blankslate", // "Create your first GitHub project"
        "#package-results" // main content of Packages
      ]
    },
    {
      "id": "hackernews-meta",
      "name": "Hacker News",
      "description": "Skip the score/age/comment-count lines, the top navigation and the footer.",
      "includeUrls": "news.ycombinator.com/*",
      "excludeSelectors": [
        ".subtext",
        ".pagetop", // header
        ".comhead",
        ".reply", // reply button
        "#hnmain > tbody > tr:nth-child(4)" // footer
      ]
    },
    {
      "id": "wikipedia-wiki",
      "name": "Wikipedia",
      "description": "Retain the article body but remove external links.",
      "includeUrls": "*wikipedia.org/wiki/*",
      "includeSelectors": [
        ".mw-content-ltr",
        "#mw-panel-toc-list"
      ],
      "excludeSelectors": [
        "[aria-labelledby~=\"External_links\"]"
      ]
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "description": "",
      "includeUrls": "www.youtube.com/*",
      "excludeUrls": "www.youtube.com/account*",
      "includeSelectors": [
        "yt-attributed-string#content-text.ytd-comment-view-model", // user comment
        ".ytLockupMetadataViewModelTitle", // title of recommended videos
        "#description-inline-expander #expanded", // video description
        "a#video-title",
        "#description-text",
        ".shortsLockupViewModelHostOutsideMetadataTitle",
        "#title" // video title
      ],
      "injectCss": ".ytLockupMetadataViewModelTitle, .shortsLockupViewModelHostOutsideMetadataTitle, #description-text { -webkit-line-clamp: unset !important; max-height: none !important; }"
    },
    {
      "id": "google-account",
      "name": "Google Account",
      "includeUrls": "ogs.google.*/u/*/widget/account*",
      "excludeSelectors": [
        ".google-symbols[aria-hidden~=\"true\"]"
      ]
    },
    {
      "id": "google-search",
      "name": "Google Search",
      "includeUrls": "www.google.*/search?q=*",
      "excludeSelectors": [
        "#sfooter", // footer
        ".DHTy1e" // previous and next button
      ],
      "injectCss": "div[style*=\"-webkit-line-clamp:\"] { -webkit-line-clamp: unset !important; }"
    },
    {
      "id": "reddit",
      "name": "Reddit",
      "includeUrls": "www.reddit.com",
      "includeSelectors": [
